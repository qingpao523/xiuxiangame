; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="封神修道录 MVP"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://assets/godot_mvp/resources/resource_daoxing.png"

[autoload]

DataManager="*res://scripts/autoload/DataManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
UnlockManager="*res://scripts/autoload/UnlockManager.gd"
RewardManager="*res://scripts/autoload/RewardManager.gd"
RealmManager="*res://scripts/autoload/RealmManager.gd"
BreakthroughManager="*res://scripts/autoload/BreakthroughManager.gd"
EventManager="*res://scripts/autoload/EventManager.gd"
Game="*res://scripts/autoload/Game.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"

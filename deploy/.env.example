# ============================================================================
# deploy/.env.example —— 服务端环境变量模板（design/20.0 Step6 部署）
# 复制为 .env 并填真实值；经 PM2 env 或 systemd EnvironmentFile 注入。
# ============================================================================

# Node 监听端口（Nginx 反代到此端口）
PORT=3000

# MongoDB 连接（阿里云 MongoDB 实例或本机）
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=xiuxiangame

# JWT 签名密钥：务必用长随机串，例如 `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES=7d

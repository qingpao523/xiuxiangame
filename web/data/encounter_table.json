          "bonus_per_level": 0.07,
          "success": { "resources": { "refine_material": 3, "mana": 3000 }, "text": "阴火乖顺入瓶，正是上好的祭炼之材。" },
          "fail": { "resources": { "mana": -3000 }, "text": "阴火忽然反噬，你以法力强压，方才无恙。" }
        },
        {
          "text": "绕火而行",
          "kind": "safe",
          "success": { "resources": { "daoxing": 40 }, "text": "你避开阴火细观其性，于火中悟得几分地脉之理。" }
        }
      ]
    },
    {
      "encounter_id": "enc_kul_02",
      "map_id": "map_003",
      "name": "照魂残影",
      "narrative": "一面残破铜镜自阴云下缓缓转出，镜光扫处，山石上映出你的魂影。",
      "options": [
        {
          "text": "斗法碎镜",
          "kind": "battle",
          "enemy_name": "照魂残影",
          "enemy_power_ratio": 0.3,
          "success": { "resources": { "refine_material": 4, "treasure_shard": 3, "daoxing": 80 }, "text": "镜光崩碎，散作漫天照魂碎玉。" },
          "fail": { "text": "镜光森寒难敌，你以法宝护住魂影，退出山道。" }

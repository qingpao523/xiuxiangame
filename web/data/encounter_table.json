          "success": { "resources": { "daoxing": 40, "mana": 2000, "treasure_shard": 2 }, "text": "雷火落处残影俱碎，浪花里翻出几枚陈塘遗宝碎片。" },
          "fail": { "text": "残兵结阵而进，你退回礁石之上，暂避锋芒。" }
        },
        {
          "text": "施礼借道",
          "kind": "check",
          "chance": 0.75,
          "success": { "resources": { "daoxing": 15 }, "text": "你执礼甚恭，残影迟疑片刻，让开一条水路。" },
          "fail": { "resources": { "mana": -1000 }, "text": "残影不辨礼数，长戟横扫，你破费法力护身而退。" }
        }
      ]
    },
    {
      "encounter_id": "enc_chen_02",
      "map_id": "map_002",
      "name": "风雷残机",
      "narrative": "陈塘关方向一道雷光落入滩涂，坑中雷气游走不散，隐有风火之意。",
      "options": [
        {
          "text": "引雷淬体",
          "kind": "check",
          "chance": 0.55,
          "bonus_spell_type": "thunder",
          "bonus_per_level": 0.08,
          "success": { "resources": { "daoxing": 60, "mana": 1500 }, "text": "雷气入体走了一个周天，你浑身酥麻，道行大进。" },
          "fail": { "resources": { "mana": -1500 }, "text": "雷气暴烈难驯，你强行压下，气机紊乱，损了法力。" }
        },
        {
          "text": "拓印雷纹",
          "kind": "safe",
          "success": { "resources": { "spell_page": 3 }, "text": "你以符纸拓下坑中雷纹，得残页数张。" }
        }
      ]
    },
    {
      "encounter_id": "enc_chen_03",
      "map_id": "map_002",
      "name": "东海怨魂",
      "narrative": "浪头里浮着几缕不散的怨魂，随潮哭嚎。怨气与劫气交缠，稍有不慎便牵动榜文。",
      "options": [
        {
          "text": "诵咒超度",
          "kind": "check",
          "chance": 0.7,
          "success": { "resources": { "merit": 80, "daoxing": 20 }, "text": "怨魂随咒声散入月光，一缕功德金光落入灵台。" },
          "fail": { "text": "怨魂执念太深，咒声难渡，你只得退开。" }
        },
        {
          "text": "炼化怨潮",
          "kind": "safe",
          "success": { "resources": { "calamity": 60, "mana": 2500 }, "text": "你张手引怨潮入体炼化，法力暴涨，一丝劫气也随之入了命门。" }
        }
      ]
    },
    {
      "encounter_id": "enc_kul_01",
      "map_id": "map_003",
      "name": "白骨阴火",
      "narrative": "山道两侧的白骨间燃着幽幽阴火，火中隐见符纹流转。",
      "options": [
        {
          "text": "以法采火",

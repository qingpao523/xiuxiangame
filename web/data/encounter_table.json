        {
          "text": "闭目静守",
          "kind": "check",
          "chance": 0.7,
          "success": { "resources": { "daoxing": 60 }, "text": "你灵台不动，镜光照身而过，反照见自身道行深浅。" },
          "fail": { "resources": { "mana": -4000 }, "text": "镜光勾动神魂，你急运法力守住灵台，出了一身冷汗。" }
        }
      ]
    },
    {
      "encounter_id": "enc_kul_03",
      "map_id": "map_003",
      "name": "地脉裂隙",
      "narrative": "脚下山岩裂开一道细缝，地脉灵气自缝中蒸腾而上，深处隐有搏动之声。",
      "options": [
        {
          "text": "探身深入",

{
  "schema_version": "0.1.0",
  "table": "encounter_table",
  "description": "R0 凡境好玩化：游历途中遭遇事件。每次游历随机 2 个遭遇，选项类型 battle=斗法 / check=判定 / safe=稳妥。",
  "rows": [
    {
      "encounter_id": "enc_wild_01",
      "map_id": "map_001",
      "name": "拦路小妖",
      "narrative": "一头受劫气驱使的独角小妖自黑雾中窜出，双目赤红，拦住去路。",
      "options": [
        {
          "text": "斗法镇杀",
          "kind": "battle",
          "enemy_name": "独角小妖",
          "enemy_power_ratio": 0.25,
          "success": { "resources": { "daoxing": 12, "mana": 600 }, "chance_extra": { "chance": 0.4, "resources": { "spell_page": 2 } }, "text": "小妖化作黑烟散去，你在原地拾得残符与灵气。" },
          "fail": { "text": "小妖凶性大发，你且战且退，未有所获。" }
        },
        {
          "text": "绕行避让",
          "kind": "check",
          "chance": 0.8,
          "success": { "resources": { "daoxing": 4 }, "text": "你借山石掩身悄然绕过，途中顺手采得几缕灵气。" },
          "fail": { "resources": { "mana": -200 }, "text": "脚下枯枝一响，小妖追来，你仓皇施法脱身，耗了些法力。" }
        }
      ]
    },
    {
      "encounter_id": "enc_wild_02",
      "map_id": "map_001",
      "name": "荒庙残符",
      "narrative": "半塌的荒庙里，神龛下压着几张焦黑残符，符纹隐有微光。",
      "options": [
        {
          "text": "冒险探查",
          "kind": "check",
          "chance": 0.65,
          "bonus_spell_type": "weapon",
          "bonus_per_level": 0.05,
          "success": { "resources": { "spell_page": 3 }, "text": "你以法力隔空摄符，残页入袖，庙中尘埃未惊。" },
          "fail": { "resources": { "mana": -300 }, "text": "残符触手即燃，一缕劫火烧上袖口，你急忙以法力扑灭。" }
        },
        {
          "text": "拜庙而去",
          "kind": "safe",
          "success": { "resources": { "daoxing": 6 }, "text": "你整衣一拜，转身离去。心境澄明，道行反有所进。" }
        }
      ]
    },
    {
      "encounter_id": "enc_wild_03",
      "map_id": "map_001",
      "name": "山民求救",
      "narrative": "山道旁一名樵夫跌坐在地——他的柴担被一头黑毛野妖掀翻，妖物正龇牙逼近。",
      "options": [
        {
          "text": "出手相助",
          "kind": "battle",
          "enemy_name": "黑毛野妖",
          "enemy_power_ratio": 0.2,
          "success": { "resources": { "daoxing": 15, "mana": 400 }, "text": "野妖遁走，樵夫连连叩谢。你心头微暖，道行更稳。" },
          "fail": { "text": "野妖悍不畏死，你护着樵夫且战且退，总算保他无恙。" }
        },
        {
          "text": "隔崖喝止",
          "kind": "check",
          "chance": 0.6,
          "bonus_spell_type": "thunder",
          "bonus_per_level": 0.06,
          "success": { "resources": { "daoxing": 10 }, "text": "你一声雷喝震落崖上碎石，野妖夹尾而逃。" },
          "fail": { "text": "妖物毫不理会，你只得亲自下场驱赶，费了番手脚。" }
        }
      ]
    },
    {
      "encounter_id": "enc_chen_01",
      "map_id": "map_002",
      "name": "巡海残兵拦路",
      "narrative": "潮雾中浮出几具巡海妖兵残影，鱼鳞甲上还挂着海藻，长戟指向你。",
      "options": [
        {
          "text": "斗法破阵",
          "kind": "battle",
          "enemy_name": "巡海残兵",
